# Firestore Migration — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Firebase Admin SDK için Service Account anahtar dosyası yolu
# Örnek: ./serviceAccountKey.json veya /absolute/path/to/key.json
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase proje ID
PROJECT_ID=surucuakademisi-f5e1f

# Varsayılan tenant ID (migration için)
# Mevcut tek kiracı: surucu_akademisi
DEFAULT_TENANT_ID=surucu_akademisi
